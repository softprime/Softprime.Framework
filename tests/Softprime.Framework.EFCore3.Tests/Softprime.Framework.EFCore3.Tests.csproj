<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net48;net10.0</TargetFrameworks>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <LangVersion>latest</LangVersion>
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
        <DefineConstants>$(DefineConstants);EFCORE3</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
        <PackageReference Include="FluentAssertions" Version="7.2.0" />
        <ProjectReference Include="../../src/data/Softprime.Framework.EFCore3/Softprime.Framework.EFCore3.csproj" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="3.1.11" />
        <ProjectReference Include="../../src/data/Softprime.Framework.Domain/Softprime.Framework.Domain.csproj" />
        <Compile Include="../EFCore/RepositoryTests.cs" Link="RepositoryTests.cs" />
    </ItemGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.0.2" GeneratePathProperty="true" />
        <!-- The .NET Framework test host resolves the SQLite DLL alongside the assembly. -->
        <None Include="$(PkgSQLitePCLRaw_lib_e_sqlite3)/runtimes/win-x64/native/e_sqlite3.dll"
              Link="e_sqlite3.dll" CopyToOutputDirectory="PreserveNewest" />
        <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
