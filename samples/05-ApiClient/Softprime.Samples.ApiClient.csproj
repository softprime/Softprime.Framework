<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <RootNamespace>Softprime.Samples.ApiClient</RootNamespace>
    <AssemblyName>Softprime.Samples.ApiClient</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\api\Softprime.Framework.Api.Client\Softprime.Framework.Api.Client.csproj" Condition="'$(UseInstalledPackages)' != 'true'" />
    <PackageReference Include="Softprime.Framework.Api.Client" Version="$(FrameworkPackageVersion)" Condition="'$(UseInstalledPackages)' == 'true'" />
    <ProjectReference Include="..\..\src\api\Softprime.Framework.Api.Dto\Softprime.Framework.Api.Dto.csproj" Condition="'$(UseInstalledPackages)' != 'true'" />
    <PackageReference Include="Softprime.Framework.Api.Dto" Version="$(FrameworkPackageVersion)" Condition="'$(UseInstalledPackages)' == 'true'" />
  </ItemGroup>

</Project>
