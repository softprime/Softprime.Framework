<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <RootNamespace>Softprime.Samples.WebApi</RootNamespace>
    <AssemblyName>Softprime.Samples.WebApi</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\api\Softprime.Framework.Api\Softprime.Framework.Api.csproj" Condition="'$(UseInstalledPackages)' != 'true'" />
    <PackageReference Include="Softprime.Framework.Api" Version="$(FrameworkPackageVersion)" Condition="'$(UseInstalledPackages)' == 'true'" />
    <ProjectReference Include="..\..\src\api\Softprime.Framework.Api.Dto\Softprime.Framework.Api.Dto.csproj" Condition="'$(UseInstalledPackages)' != 'true'" />
    <PackageReference Include="Softprime.Framework.Api.Dto" Version="$(FrameworkPackageVersion)" Condition="'$(UseInstalledPackages)' == 'true'" />
  </ItemGroup>

</Project>
